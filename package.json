{
  "name": "torlnk",
  "version": "1.6.0",
  "description": "A sleek, zero-setup torrent finder and downloader that lives right in your terminal.",
  "type": "module",
  "main": "dist/gui/main.js",
  "bin": {
    "torlnk": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "preview",
    "scripts/ensure-webrtc.cjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "gui": "npm run build && electron dist/gui/main.js",
    "package:win": "npm run build && electron-builder --win portable",
    "build": "tsup && tsup --config tsup.gui.config.ts",
    "postbuild": "node scripts/postbuild.cjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:seeding": "tsx scripts/verify-seeding.ts",
    "previews": "tsx scripts/render-previews.tsx",
    "postinstall": "node scripts/ensure-webrtc.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "torrent",
    "torrent-client",
    "torrent-search",
    "downloader",
    "magnet",
    "magnet-links",
    "p2p",
    "webtorrent",
    "seeding",
    "tui",
    "terminal",
    "cli",
    "ink",
    "zero-configuration",
    "zero-setup",
    "fitgirl"
  ],
  "author": "bairon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baairon/torlink.git"
  },
  "homepage": "https://torlink.bairon.dev",
  "bugs": {
    "url": "https://github.com/baairon/torlink/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "env-paths": "^4.0.0",
    "ink": "^7.0.5",
    "parse-torrent": "^11.0.21",
    "react": "^19.2.7",
    "uint8-util": "2.2.6",
    "webtorrent": "^2.4.1"
  },
  "overrides": {
    "uint8-util": "2.2.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "electron@39.2.7": true
  },
  "build": {
    "appId": "dev.bairon.torlink",
    "productName": "Torlink",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/gui/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-datachannel/**",
      "node_modules/utp-native/**",
      "node_modules/bufferutil/**",
      "node_modules/utf-8-validate/**"
    ]
  }
}
