{
  "name": "klink",
  "version": "1.6.0",
  "description": "Klink - A sleek, zero-setup torrent finder and downloader TUI with peer inspection, media streaming, and turtle mode.",
  "type": "module",
  "bin": {
    "klink": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "preview",
    "scripts/ensure-webrtc.cjs"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "postbuild": "node scripts/postbuild.cjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:seeding": "tsx scripts/verify-seeding.ts",
    "previews": "tsx scripts/render-previews.tsx",
    "postinstall": "node scripts/ensure-webrtc.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "torrent",
    "torrent-client",
    "torrent-search",
    "downloader",
    "magnet",
    "magnet-links",
    "p2p",
    "webtorrent",
    "seeding",
    "tui",
    "terminal",
    "cli",
    "ink",
    "zero-configuration",
    "zero-setup",
    "fitgirl"
  ],
  "author": "bairon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiserc/klink.git"
  },
  "homepage": "https://github.com/kaiserc/klink",
  "bugs": {
    "url": "https://github.com/kaiserc/klink/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "env-paths": "^4.0.0",
    "ink": "^7.1.1",
    "parse-torrent": "^11.0.21",
    "react": "^19.2.8",
    "serve-handler": "^6.1.7",
    "uint8-util": "2.2.6",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/serve-handler": "^6.1.4",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "bufferutil@4.1.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "ip-set@3.0.0": true,
    "node-datachannel@0.32.3": true,
    "utf-8-validate@6.0.6": true,
    "utp-native@2.5.3": true
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "ip": "^2.0.1",
    "uint8-util": "2.2.6"
  }
}
